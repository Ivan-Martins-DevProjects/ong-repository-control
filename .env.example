# ============================================================================
# Configuração de desenvolvimento
#
# Copie este arquivo para `.env` e ajuste os valores:
#   cp .env.example .env
#
# IMPORTANTE:
#  - `.env.example` é versionado (template SEM segredos reais).
#  - `.env` contém os valores reais de desenvolvimento e NÃO é versionado
#    (está no .gitignore). Nunca inclua `.env` em um commit.
# ============================================================================

# --- PostgreSQL ------------------------------------------------------------
# Usuário / senha / banco usados pelo container postgres e pela conexão do
# backend. Troque a senha antes de usar fora de máquina local.
POSTGRES_USER=repositorycontrol
POSTGRES_PASSWORD=troque-esta-senha-em-dev
POSTGRES_DB=repositorycontrol

# --- Backend (JWT) ---------------------------------------------------------
# Chave de assinatura dos tokens. Gere uma aleatória com:
#   openssl rand -base64 48
JWT_SECRET=troque-esta-chave-aleatoria

# Conexão do backend com o banco (usada via ConnectionStrings__DefaultConnection
# dentro do container; aponta para o serviço `postgres`).
# Para rodar o backend localmente (`dotnet run`), exporte:
#   export ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
#   export Jwt__SecretKey="$JWT_SECRET"